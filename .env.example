APP_ENV=production

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_WEBHOOK_ID=replace-after-live-webhook-registration
PAYPAL_MERCHANT_ID=replace-with-live-receiver-merchant-id
PAYPAL_TIMEOUT_SECONDS=10
MAX_WEBHOOK_BYTES=1048576

TENANT_TOKEN_ISSUER=https://apexsovereign.ai
TENANT_TOKEN_AUDIENCE=apexsovereign-api
TENANT_TOKEN_HMAC_KEYS_JSON={"2026-09":"base64url-encoded-32-byte-or-longer-secret"}
TENANT_TOKEN_CURRENT_KID=2026-09
TENANT_TOKEN_TTL_SECONDS=900

REQUIRE_PQC=false
PQC_ALGORITHM=ML-DSA-65
# PQC_KEY_ID=mldsa65-2026-09
# PQC_PRIVATE_KEY_FILE=/run/secrets/mldsa65-private.b64
# PQC_PUBLIC_KEY_FILE=/run/secrets/mldsa65-public.b64
